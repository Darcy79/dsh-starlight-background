{
  "name": "dsh-starlight-background",
  "version": "0.4.1",
  "private": true,
  "description": "A Starlight light field and animated ocean illustration with gear settings, a master switch, independent reasoning-linked meteors, and separate illustration visibility and animation controls.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "src",
    "scripts",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "starlight",
    "light",
    "ambient"
  ],
  "scripts": {
    "build:artwork": "node scripts/embed-artwork.mjs",
    "preview": "node scripts/preview.mjs",
    "check:artwork": "node scripts/check-artwork.mjs",
    "check": "node scripts/check.mjs && node scripts/check-behavior.mjs"
  },
  "license": "MIT"
}
